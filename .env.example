# Anthropic (Claude API for signal summaries)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# SnapTrade (read-only CommSec portfolio sync)
SNAPTRADE_CLIENT_ID=your_snaptrade_client_id_here
SNAPTRADE_CLIENT_SECRET=your_snaptrade_client_secret_here

# Resend (email alerts)
RESEND_API_KEY=your_resend_api_key_here
ALERT_EMAIL_TO=you@example.com
ALERT_EMAIL_FROM=alerts@yourdomain.com

# Pushover (push notifications)
PUSHOVER_USER_KEY=your_pushover_user_key_here
PUSHOVER_API_TOKEN=your_pushover_api_token_here

# Flask
FLASK_SECRET_KEY=change_this_to_a_random_string
FLASK_ENV=development

# Database
DATABASE_PATH=db/stockpicker.db
